<?xml version="1.0"?>
<!--
  Slamtec RPLidar S2E (Ethernet version of the S2): 77 x 77 x ~38.5 mm, 190 g.
  Range 0.05-30 m, 10 Hz, 0.1125 deg resolution (3200 samples per turn), accuracy about +/-30 mm.
  Frames: <name>_link = bottom centre of the housing, <name>_laser = scan plane (frame_id of the scan).
  laser_z is approximate: check the scan-plane height on Slamtec's S2E mechanical drawing.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rplidar_s2e" params="name parent topic *origin
                                          samples:=3200 rate:=10 laser_z:=0.028 stddev:=0.015">
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0.01925" rpy="0 0 0"/>
        <geometry><cylinder radius="0.0385" length="0.0385"/></geometry>
        <material name="rplidar_black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.01925" rpy="0 0 0"/>
        <geometry><cylinder radius="0.0385" length="0.0385"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.01925" rpy="0 0 0"/>
        <mass value="0.19"/>
        <inertia ixx="9.4e-5" ixy="0" ixz="0" iyy="9.4e-5" iyz="0" izz="1.4e-4"/>
      </inertial>
    </link>

    <joint name="${name}_laser_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_laser"/>
      <origin xyz="0 0 ${laser_z}" rpy="0 0 0"/>
    </joint>
    <link name="${name}_laser"/>

    <gazebo reference="${name}_laser">
      <sensor name="${name}" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>${rate}</update_rate>
        <topic>${topic}</topic>
        <gz_frame_id>${name}_laser</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>${samples}</samples>
              <resolution>1</resolution>
              <min_angle>${-pi}</min_angle>
              <max_angle>${pi - 2*pi/samples}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>${stddev}</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>

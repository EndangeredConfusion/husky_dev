<?xml version="1.0"?>
<!--
  Extras for the Clearpath Husky A200 (robot.yaml -> platform.extras.urdf).
  Positions are estimated from a top-view picture (about +/-5 cm): measure and correct them.
  Frame: x forward, y left, z up, relative to default_mount (top plate centre).
  - RPLidar S2E on the top plate, 11 cm ahead of centre. Scan topic = sensors/lidar2d_0/scan (Nav2 default).
  - ZED 2i camera (sim): Gazebo topic sensors/zed_sim/*, bridged to ROS sensors/camera_0/*
    (own Gazebo topic so it never mixes with Clearpath's camera_0)
  - u-blox ZED-X20D dual-antenna GNSS: front + rear antennas on the centreline, about 0.65 m apart.
    The real receiver computes heading from this baseline; in sim each antenna publishes its own fix.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="ns" value="a200_0000"/>
  <xacro:include filename="$(find husky_description)/urdf/rplidar_s2e.urdf.xacro"/>
  <xacro:include filename="$(find husky_description)/urdf/gps.urdf.xacro"/>
  <xacro:include filename="$(find husky_description)/urdf/zed2i_sim.urdf.xacro"/>

  <xacro:rplidar_s2e name="rplidar" parent="default_mount" topic="/${ns}/sensors/lidar2d_0/scan">
    <origin xyz="0.11 0.0 0.0" rpy="0 0 0"/>
  </xacro:rplidar_s2e>

  <!-- ZED-X20D antennas. stddev 0.02 m assumes RTK fix; use about 1.5 m to simulate no corrections. -->
  <xacro:gps_antenna name="gps_front" parent="default_mount" topic="/${ns}/sensors/gps_0/fix" stddev_h="0.02" stddev_v="0.04">
    <origin xyz="0.36 -0.02 0.05" rpy="0 0 0"/>
  </xacro:gps_antenna>
  <xacro:gps_antenna name="gps_rear" parent="default_mount" topic="/${ns}/sensors/gps_1/fix" stddev_h="0.02" stddev_v="0.04">
    <origin xyz="-0.29 0.03 0.05" rpy="0 0 0"/>
  </xacro:gps_antenna>

  <!-- ZED 2i simulation (sim only). Keep this origin the same as the camera xyz in robot.yaml. -->
  <xacro:zed2i_sim name="zed_sim" parent="default_mount" topic="/${ns}/sensors/zed_sim">
    <origin xyz="0.05 0.0 0.20" rpy="0 0 0"/>
  </xacro:zed2i_sim>
</robot>

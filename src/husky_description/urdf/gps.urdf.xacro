<?xml version="1.0"?>
<!--
  Generic GPS/GNSS antenna puck with a Gazebo NavSat sensor.
  The world's <spherical_coordinates> sets the real lat/lon (rpi_86_field: KML point 1).
  stddev_h / stddev_v: position noise in metres (about 2.0 for a basic receiver, 0.02 for RTK).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="gps_antenna" params="name parent topic *origin rate:=10 stddev_h:=1.5 stddev_v:=3.0">
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <geometry><cylinder radius="0.045" length="0.02"/></geometry>
        <material name="gps_grey"><color rgba="0.85 0.85 0.85 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <geometry><cylinder radius="0.045" length="0.02"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <mass value="0.15"/>
        <inertia ixx="8.1e-5" ixy="0" ixz="0" iyy="8.1e-5" iyz="0" izz="1.5e-4"/>
      </inertial>
    </link>

    <gazebo reference="${name}_link">
      <sensor name="${name}" type="navsat">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <topic>${topic}</topic>
        <gz_frame_id>${name}_link</gz_frame_id>
        <navsat>
          <position_sensing>
            <horizontal><noise type="gaussian"><mean>0.0</mean><stddev>${stddev_h}</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><mean>0.0</mean><stddev>${stddev_v}</stddev></noise></vertical>
          </position_sensing>
        </navsat>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>

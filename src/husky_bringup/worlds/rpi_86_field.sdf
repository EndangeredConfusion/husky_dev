<?xml version="1.0" ?>
<!--
  RPI '86 Field (Troy, NY) for Clearpath Gazebo sim.
  World origin (0,0) = KML point 1 (grid cell (1,1), the start). +x = east, +y = north (ENU), meters.
  Pavement is visual only (flat, drivable). Obstacles with collision: tree trunks + pots at points 2 and 3.
  Generated from 86_Field_Map.kml + satellite trace + grid map. Grid cell -> (x, y) table: rpi_86_field_waypoints.yaml
-->
<sdf version="1.9">
  <world name="rpi_86_field">
    <physics name="1ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <!-- GPS (NavSat) reads real lat/lon: (0,0) is KML point 1 -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>42.7307205808</latitude_deg>
      <longitude_deg>-73.6805864698</longitude_deg>
      <elevation>66.00</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.65 0.80 0.95 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="grass">
      <static>true</static>
      <pose>55 -45 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>400 300</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><cast_shadows>false</cast_shadows><geometry><plane><normal>0 0 1</normal><size>400 300</size></plane></geometry><material><ambient>0.300 0.550 0.200 1</ambient><diffuse>0.300 0.550 0.200 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
      </link>
    </model>

    <model name="pavement">
      <static>true</static>
      <link name="link">
        <visual name="v1"><pose>17.806 -81.776 0.0300 0 0 -0.1359</pose><geometry><box><size>60.259 4.500 0.002</size></box></geometry><material><ambient>0.530 0.510 0.550 1</ambient><diffuse>0.530 0.510 0.550 1</diffuse><specular>0.05 0.05 0.05 1</specular></material><cast_shadows>false</cast_shadows></visual>
